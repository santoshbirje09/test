{
  "$schema": "https://schema.management.azure.com/schema/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[deployment().location]",
      "metadata": { "description": "The Azure region for deployment." }
    },
    "aksResourceGroupName": {
      "type": "string",
      "metadata": { "description": "Resource group that will hold the cluster, storage and identities." }
    },
    "aksClusterName": {
      "type": "string",
      "metadata": { "description": "Name of the AKS cluster the SaaS platform will create." }
    }
  },
  "variables": {
    "identityName": "SaaS-K8sOrchestrator-Identity",
    "onboardingId": "__SET_BY_SERVER__",
    "saasTenantId": "__SET_BY_SERVER__",
    "saasServicePrincipalObjectId": "__SET_BY_SERVER__",
    "webhookUrl": "__SET_BY_SERVER__",
    "roleDefGuid": "[guid(subscription().id, parameters('aksResourceGroupName'), 'SaaS-DataCluster-Manager')]",
    "customRoleName": "[format('SaaS-DataCluster-Manager-{0}', uniqueString(subscription().subscriptionId, parameters('aksResourceGroupName')))]",
    "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleDefGuid'))]",
    "rgId": "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('aksResourceGroupName'))]",
    "saasIssuer": "[format('https://login.microsoftonline.com/{0}/v2.0', variables('saasTenantId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2023-07-01",
      "name": "[parameters('aksResourceGroupName')]",
      "location": "[parameters('location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.Authorization/roleDefinitions",
      "apiVersion": "2022-04-01",
      "name": "[variables('roleDefGuid')]",
      "dependsOn": [
        "[variables('rgId')]"
      ],
      "properties": {
        "roleName": "[variables('customRoleName')]",
        "description": "Lets the SaaS platform build an AKS cluster and ADLS Gen2 account in this resource group and run data jobs on it.",
        "type": "CustomRole",
        "permissions": [
          {
            "actions": [
              "Microsoft.ContainerService/managedClusters/*",
              "Microsoft.Compute/virtualMachines/*",
              "Microsoft.Compute/virtualMachineScaleSets/*",
              "Microsoft.Network/virtualNetworks/*",
              "Microsoft.Network/networkInterfaces/*",
              "Microsoft.ManagedIdentity/userAssignedIdentities/*",
              "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials/*",
              "Microsoft.Authorization/roleAssignments/read",
              "Microsoft.Authorization/roleAssignments/write",
              "Microsoft.Authorization/roleAssignments/delete",
              "Microsoft.Storage/storageAccounts/*"
            ],
            "notActions": [],
            "dataActions": [
              "Microsoft.ContainerService/managedClusters/pods/*",
              "Microsoft.ContainerService/managedClusters/batch/jobs/*",
              "Microsoft.ContainerService/managedClusters/namespaces/*",
              "Microsoft.ContainerService/managedClusters/serviceaccounts/*",
              "Microsoft.Storage/storageAccounts/blobServices/containers/blobs/*"
            ],
            "notDataActions": []
          }
        ],
        "assignableScopes": [
          "[variables('rgId')]"
        ]
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2023-07-01",
      "name": "saas-identity-and-roles-deployment",
      "resourceGroup": "[parameters('aksResourceGroupName')]",
      "dependsOn": [
        "[variables('rgId')]",
        "[variables('roleDefinitionId')]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": { "scope": "inner" },
        "parameters": {
          "location": { "value": "[parameters('location')]" },
          "identityName": { "value": "[variables('identityName')]" },
          "onboardingId": { "value": "[variables('onboardingId')]" },
          "roleDefinitionId": { "value": "[variables('roleDefinitionId')]" },
          "saasIssuer": { "value": "[variables('saasIssuer')]" },
          "saasSubject": { "value": "[variables('saasServicePrincipalObjectId')]" },
          "aksResourceGroupName": { "value": "[parameters('aksResourceGroupName')]" },
          "aksClusterName": { "value": "[parameters('aksClusterName')]" },
          "webhookUrl": { "value": "[variables('webhookUrl')]" }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schema/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "location": { "type": "string" },
            "identityName": { "type": "string" },
            "onboardingId": { "type": "string" },
            "roleDefinitionId": { "type": "string" },
            "saasIssuer": { "type": "string" },
            "saasSubject": { "type": "string" },
            "aksResourceGroupName": { "type": "string" },
            "aksClusterName": { "type": "string" },
            "webhookUrl": { "type": "securestring" }
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[parameters('identityName')]",
              "location": "[parameters('location')]",
              "tags": {
                "saas-onboarding-id": "[parameters('onboardingId')]"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, parameters('identityName'), parameters('roleDefinitionId'))]",
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
              ],
              "properties": {
                "roleDefinitionId": "[parameters('roleDefinitionId')]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal",
                "conditionVersion": "2.0",
                "condition": "((!(ActionMatches{'Microsoft.Authorization/roleAssignments/write'})) OR (@Request[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAnyValues:GuidEquals {ba92f5b4-2d11-453d-a403-e96b0029c9fe})) AND ((!(ActionMatches{'Microsoft.Authorization/roleAssignments/delete'})) OR (@Resource[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAnyValues:GuidEquals {ba92f5b4-2d11-453d-a403-e96b0029c9fe}))"
              }
            },
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
              "apiVersion": "2023-01-31",
              "name": "[format('{0}/SaaSDataOrchestrationTrust', parameters('identityName'))]",
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
              ],
              "properties": {
                "issuer": "[parameters('saasIssuer')]",
                "subject": "[parameters('saasSubject')]",
                "audiences": [
                  "api://AzureADTokenExchange"
                ]
              }
            },
            {
              "type": "Microsoft.Resources/deploymentScripts",
              "apiVersion": "2023-08-01",
              "name": "WebhookNotificationScript",
              "location": "[parameters('location')]",
              "kind": "AzureCLI",
              "dependsOn": [
                "[resourceId('Microsoft.Authorization/roleAssignments', guid(resourceGroup().id, parameters('identityName'), parameters('roleDefinitionId')))]",
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials', parameters('identityName'), 'SaaSDataOrchestrationTrust')]"
              ],
              "properties": {
                "azCliVersion": "2.50.0",
                "timeout": "PT5M",
                "retentionInterval": "P1D",
                "cleanupPreference": "Always",
                "environmentVariables": [
                  { "name": "WEBHOOK_URL", "secureValue": "[parameters('webhookUrl')]" },
                  { "name": "TENANT_ID", "value": "[tenant().tenantId]" },
                  { "name": "SUB_ID", "value": "[subscription().subscriptionId]" },
                  { "name": "CLIENT_ID", "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').clientId]" },
                  { "name": "RG_NAME", "value": "[parameters('aksResourceGroupName')]" },
                  { "name": "CLUSTER_NAME", "value": "[parameters('aksClusterName')]" }
                ],
                "scriptContent": "curl -fsS --retry 5 --retry-delay 5 -X POST -H 'Content-Type: application/json' -d \"{\\\"azureTenantId\\\":\\\"$TENANT_ID\\\",\\\"azureSubscriptionId\\\":\\\"$SUB_ID\\\",\\\"managedIdentityClientId\\\":\\\"$CLIENT_ID\\\",\\\"targetResourceGroup\\\":\\\"$RG_NAME\\\",\\\"targetClusterName\\\":\\\"$CLUSTER_NAME\\\"}\" \"$WEBHOOK_URL\""
              }
            }
          ],
          "outputs": {
            "clientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').clientId]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "azureTenantId": { "type": "string", "value": "[tenant().tenantId]" },
    "azureSubscriptionId": { "type": "string", "value": "[subscription().subscriptionId]" },
    "managedIdentityClientId": { "type": "string", "value": "[reference('saas-identity-and-roles-deployment').outputs.clientId.value]" },
    "targetResourceGroup": { "type": "string", "value": "[parameters('aksResourceGroupName')]" },
    "targetClusterName": { "type": "string", "value": "[parameters('aksClusterName')]" }
  }
}
